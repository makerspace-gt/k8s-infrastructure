{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "platformAutomerge": true,
  "ignoreTests": true,
  "minimumReleaseAge": "3 days",
  "internalChecksFilter": "strict",
  "flux": {
    "fileMatch": [
      "(^|/).*\\.ya?ml$"
    ]
  },
  "helm-values": {
    "fileMatch": [
      "(^|/).*\\.ya?ml$"
    ]
  },
  "kubernetes": {
    "fileMatch": [
      "(^|/).*\\.ya?ml$"
    ]
  },
  "schedule": [
    "at any time"
  ],
  "packageRules": [
    {
      "description": "Auto-merge patch and minor updates",
      "matchUpdateTypes": [
        "patch",
        "minor"
      ],
      "automerge": true
    },
    {
      "description": "Major updates require manual approval",
      "matchUpdateTypes": [
        "major"
      ],
      "dependencyDashboardApproval": true
    },
    {
      "description": "Longhorn: never auto-bump minor/major. Longhorn forbids skipping minor versions, so upgrades must be done one minor at a time by hand (see docs/cluster-bootstrap.md). Patch bumps within the deployed minor stay auto-merged.",
      "matchPackageNames": [
        "longhorn"
      ],
      "matchUpdateTypes": [
        "minor",
        "major"
      ],
      "automerge": false,
      "dependencyDashboardApproval": true
    }
  ],
  "separateMajorMinor": true,
  "dependencyDashboard": true,
  "semanticCommits": "enabled"
}
